# Public multiplex relay (safe to commit / ship on Pages)
VITE_MULTIPLEX_URL=https://multiplex.up.railway.app

# Audience site used when copying student links (local presenter console)
VITE_PUBLIC_SITE_URL=https://4geeksacademy.github.io/ft-ai-4-presentations

# Optional: pin a session id for local testing (or pass ?id= in the URL)
# VITE_MULTIPLEX_ID=

# Local master only — copy to `.env.local`, never commit, never set in CI
# Prefer the Presenter session UI (?presenter=1) over baking secrets here.
# Get a pair from https://multiplex.up.railway.app/token  (fields: secret + socketId → use as id)
# VITE_MULTIPLEX_ROLE=master
# VITE_MULTIPLEX_SECRET=
